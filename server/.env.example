# Copia a .env (o exporta las variables) cuando tengas el ambiente real de VELARIS.
# NUNCA subas el .env a GitHub: contiene el Client Secret.
VELARIS_URL=https://URL-DE-PRUEBAS-QUE-ENTREGUE-VELARIS
VELARIS_CLIENT_ID=
VELARIS_CLIENT_SECRET=
# 1 = firma cada escritura con HMAC-SHA256 (X-Signature), si VELARIS lo activa
VELARIS_SIGN=0
PORT=4000
CATALOG_TTL_MS=300000
STOCK_POLL_MS=30000
